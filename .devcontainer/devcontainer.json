// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
	"name": "Go",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// "ghcr.io/joshuanianji/devcontainer-features/mount-pnpm-store:1": {},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "sudo apt-get update && sudo apt-get install -y zenity",
	"postCreateCommand": "cd frontend && pnpm install",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"GrapeCity.gc-excelviewer",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss",
				"mhutchie.git-graph",
				"vitest.explorer"
			],
			"settings": {
				"go.lintOnSave": "workspace",
				"go.lintTool": "golangci-lint",
				"go.lintFlags": [
					"--fast"
				],
				"go.coverOnSave": true,
				"go.testEnvVars": {
					"DISABLE_EXTERNAL_HTTP": "true"
				},
				"svelte.enable-ts-plugin": true,
				"editor.formatOnSave": true,
				"[svelte]": {
					"editor.defaultFormatter": "svelte.svelte-vscode",
					"editor.codeActionsOnSave": [
						"source.organizeImports"
					]
				}
			}
		}
	},
	"containerEnv": {
		"HOME": "/home/vscode",
		"GOPATH": "/home/vscode/go",
		"GOMODCACHE": "/home/vscode/go/pkg/mod"
	},
	"forwardPorts": [
		63315
	],
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode"
}