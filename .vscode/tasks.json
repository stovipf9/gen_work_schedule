{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Windows Binary",
			"type": "shell",
			"command": "cd ${workspaceFolder}/cmd; CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -a -ldflags '-s -w -extldflags \"-static\"' -o ${workspaceFolder}/build/GenWorkSchedule.exe",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$go"
			]
		},
		{
			"label": "Generate Go Branch Coverage(C1) Report",
			"type": "shell",
			"command": "go",
			"args": [
				"test",
				"-coverprofile=coverage.out",
				"-covermode=count",
				"-coverpkg=./cmd",
				"./...",
				"&&",
				"go",
				"tool",
				"cover",
				"-html=coverage.out",
				"-o",
				"coverage.html",
				"&&",
				"rm",
				"coverage.out"
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "build",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"CGO_ENABLED": "1"
				}
			},
			"osx": {
				"options": {
					"env": {
						"CGO_CFLAGS": "-mmacosx-version-min=10.13",
						"CGO_LDFLAGS": "-framework UniformTypeIdentifiers -mmacosx-version-min=10.13"
					}
				}
			},
			"windows": {
				"options": {
					"env": {
						"CGO_ENABLED": "0"
					}
				}
			},
			"command": "go",
			"args": [
				"build",
				"-tags",
				"production,desktop",
				"-gcflags",
				"all=-N -l",
				"-o",
				"build/bin/gen_work_schedule"
			]
		},
		{
			"label": "build debug",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"CGO_ENABLED": "1"
				}
			},
			"osx": {
				"options": {
					"env": {
						"CGO_CFLAGS": "-mmacosx-version-min=10.13",
						"CGO_LDFLAGS": "-framework UniformTypeIdentifiers -mmacosx-version-min=10.13"
					}
				}
			},
			"windows": {
				"options": {
					"env": {
						"CGO_ENABLED": "0"
					}
				}
			},
			"command": "go",
			"args": [
				"build",
				"-tags",
				"production,desktop,debug",
				"-gcflags",
				"all=-N -l",
				"-o",
				"build/bin/gen_work_schedule"
			]
		},
		{
			"label": "build dev",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"CGO_ENABLED": "1"
				}
			},
			"osx": {
				"options": {
					"env": {
						"CGO_CFLAGS": "-mmacosx-version-min=10.13",
						"CGO_LDFLAGS": "-framework UniformTypeIdentifiers -mmacosx-version-min=10.13"
					}
				}
			},
			"windows": {
				"options": {
					"env": {
						"CGO_ENABLED": "0"
					}
				}
			},
			"command": "go",
			"args": [
				"build",
				"-tags",
				"dev",
				"-gcflags",
				"all=-N -l",
				"-o",
				"build/bin/gen_work_schedule"
			]
		}
	]
}