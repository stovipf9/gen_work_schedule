{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "wails: build windows/amd64 + zip",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GOOS": "windows",
					"GOARCH": "amd64",
					"CGO_ENABLED": "0"
				}
			},
			"command": [
				"wails",
				"build",
				"-platform",
				"windows/amd64",
				"-clean",
				"-upx",
				"&&",
				"cp",
				"build/bin/gen_work_schedule.exe",
				"release",
				"&&",
				"pandoc",
				"-s",
				"-o",
				"release/README.pdf",
				"README.md",
				"--pdf-engine=weasyprint",
				"&&",
				"rm",
				"-f",
				"gen_work_schedule-windows.zip",
				"&&",
				"cd",
				"release",
				"&&",
				"zip",
				"-r",
				"-9",
				"../gen_work_schedule-windows.zip",
				"./*",
				"&&",
				"echo",
				"'ZIP生成完了: gen_work_schedule-windows.zip'"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Generate Go Coverage Report",
			"type": "shell",
			"command": "go",
			"args": [
				"test",
				"-coverprofile=coverage.out",
				"-covermode=count",
				"-coverpkg=./cmd",
				"./...",
				"&&",
				"go",
				"tool",
				"cover",
				"-html=coverage.out",
				"-o",
				"cmd/backend_coverage.html",
				"&&",
				"rm",
				"coverage.out"
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "build dev",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"CGO_ENABLED": "1"
				}
			},
			"osx": {
				"options": {
					"env": {
						"CGO_CFLAGS": "-mmacosx-version-min=10.13",
						"CGO_LDFLAGS": "-framework UniformTypeIdentifiers -mmacosx-version-min=10.13"
					}
				}
			},
			"windows": {
				"options": {
					"env": {
						"CGO_ENABLED": "0"
					}
				}
			},
			"dependsOn": [
				"mkdir-build",
				"build frontend"
			],
			"command": "go",
			"args": [
				"build",
				"-tags",
				"dev,webkit2_41",
				"-gcflags",
				"all=-N -l",
				"-o",
				"build/bin/gen_work_schedule"
			]
		},
		{
			"label": "build frontend",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"command": "pnpm",
			"args": [
				"run",
				"generate-bindings"
			],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "mkdir-build",
			"type": "shell",
			"command": "mkdir",
			"args": [
				"-p",
				"build/bin"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			}
		}
	]
}