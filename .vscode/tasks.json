{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "wails: build windows/amd64",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GOOS": "windows",
					"GOARCH": "amd64",
					"CGO_ENABLED": "0",
				}
			},
			"command": "wails",
			"args": [
				"build",
				"-platform",
				"windows/amd64",
				"-clean",
				"-upx"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Generate Go Branch Coverage(C1) Report",
			"type": "shell",
			"command": "go",
			"args": [
				"test",
				"-coverprofile=coverage.out",
				"-covermode=count",
				"-coverpkg=./cmd",
				"./...",
				"&&",
				"go",
				"tool",
				"cover",
				"-html=coverage.out",
				"-o",
				"cmd/backend_coverage.html",
				"&&",
				"rm",
				"coverage.out"
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "build dev",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"CGO_ENABLED": "1"
				}
			},
			"osx": {
				"options": {
					"env": {
						"CGO_CFLAGS": "-mmacosx-version-min=10.13",
						"CGO_LDFLAGS": "-framework UniformTypeIdentifiers -mmacosx-version-min=10.13"
					}
				}
			},
			"windows": {
				"options": {
					"env": {
						"CGO_ENABLED": "0"
					}
				}
			},
			"command": "go",
			"args": [
				"build",
				"-tags",
				"dev,webkit2_41",
				"-gcflags",
				"all=-N -l",
				"-o",
				"build/bin/gen_work_schedule"
			]
		}
	]
}